{
  "manifest_version": 3,
  "name": "Thrive OS for Gmail",
  "version": "0.1.2",
  "description": "CRM context and sales actions inside Gmail.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://app.thrivedev.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
